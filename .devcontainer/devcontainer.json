{
  "name": "KAORI Docs Development",
  "dockerComposeFile": [
    "../compose.dev.yml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace"
  ],
  "workspaceFolder": "/workspace/kaori-docs",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "KAORI Docs (Docusaurus)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "postCreateCommand": "npm ci --no-audit --no-fund"
}
